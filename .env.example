# API Key (OpenAI, OpenRouter или любого совместимого провайдера)
AI_API_KEY=your_api_key_here

# Base URL API (без завершающего слэша)
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama / LocalAI: http://localhost:11434/v1
API_BASE_URL=https://openrouter.ai/api/v1

# Модель нейросети (например: gpt-4o, openai/gpt-6-luna, gpt-4o-mini)
AI_MODEL=openai/gpt-6-luna

# Таймаут запроса в секундах (по умолчанию 20)
AI_TIMEOUT=20

# Опциональный HTTP/HTTPS прокси (например: http://127.0.0.1:10809 или socks5://127.0.0.1:1080)
# HTTP_PROXY=http://127.0.0.1:10809

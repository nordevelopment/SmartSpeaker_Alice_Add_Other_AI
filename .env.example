# API Key (OpenAI, OpenRouter или любого совместимого провайдера)
AI_API_KEY=your_api_key_here

#чтобы чужие не подключились
SECRET_KEY=YOUR_SEKCRET_WORD

# Base URL API (без завершающего слэша)
API_BASE_URL=https://openrouter.ai/api/v1

#API_BASE_URL может быть любой другой совместимого OpenAI, например от OpenAI: https://api.openai.com/v1

# Для локального запуска
# Ollama / LocalAI: http://localhost:11434/v1

# Модель нейросети (например: gpt-4o, openai/gpt-6-luna, gpt-4o-mini)
AI_MODEL=openai/gpt-6-luna

# Таймаут запроса в секундах (по умолчанию 20)
AI_TIMEOUT=20

# Максимальное количество токенов ответа (для укладывания в лимит Алисы 3-4 сек)
AI_MAX_TOKENS=400

# Управление размышлениями (reasoning): OFF / NONE (отключено), MINIMAL, LOW, MEDIUM
REASONING=OFF

SYSTEM_PROMPT="Ты голосовой ИИ-помощник, работаешь в умной колонке Алиса и говоришь голосом Алисы. Отвечай кратко, по сути, разговорным языком (1-3 предложения), без списков и без markdown-разметки."

# Опциональный HTTP/HTTPS прокси (например: http://127.0.0.1:10809 или socks5://127.0.0.1:1080)
# HTTP_PROXY=http://127.0.0.1:10809
